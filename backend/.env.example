STACK_UNDERFLOW_ENV_ID=local
# Generate a secret locally; never commit backend/.env.
STACK_UNDERFLOW_SECRET_KEY=
# Used by Docker Compose and Django. Leave DB_HOST empty only for optional SQLite.
DB_NAME=stack_underflow
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Add demo questions/tags at backend startup. Repeated runs preserve existing rows.
SEED_DEMO_DATA=True
# For public deployment: STACK_UNDERFLOW_ENV_ID=prod, DB_SSLMODE=require,
# actual ALLOWED_HOSTS/CORS_ALLOWED_ORIGINS, and HTTPS proxy settings in docs/deployment.md.
